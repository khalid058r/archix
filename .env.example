# ============================================
# ARCHIX - Variables d'Environnement
# ============================================
# Copiez ce fichier vers .env et remplissez les valeurs
# cp .env.example .env

# ============================================
# APPLICATION
# ============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=jdbc:postgresql://localhost:5432/archix_db
DATABASE_NAME=archix_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=khalid123

# ============================================
# JWT AUTHENTICATION
# ============================================
# Générez une clé sécurisée avec: openssl rand -hex 32
JWT_SECRET=dff0d6d477a55fc7208a1095f8db44d66fb61af831cd5a4a22e1c02e20080b11
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ============================================
# MINIO (Object Storage)
# ============================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=archix-documents

# ============================================
# REDIS (Cache)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# STRIPE (Paiements) - Pour SaaS
# ============================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8081/api

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB
